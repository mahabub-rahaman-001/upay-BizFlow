# Mobile app environment variables (client-safe).
# Copy to .env and configure for local development.

EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# AI service endpoint
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Enables one-tap demo login buttons on mobile and admin login screens.
# Never set to true in production.
EXPO_PUBLIC_DEMO_MODE=true
