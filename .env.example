# Copy to .env and fill. NEVER commit real values.
# Client-safe (mobile app) - only anon key, never service role
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Server only (Edge Functions / scripts) - keep out of the app bundle
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
PAYMENT_WEBHOOK_SECRET=dev-hmac-secret-change-me

# AI service
AI_SERVICE_URL=http://localhost:8000
EXPO_PUBLIC_AI_SERVICE_URL=http://localhost:8000
LLM_API_KEY=your-llm-provider-key

# Edge Functions only (set with: npx supabase secrets set KEY=value)
# DEMO_MODE=true enables the payment simulator. Never set it in production.
DEMO_MODE=false
# Local/demo only: shows the one-tap demo login buttons. Never set in production.
EXPO_PUBLIC_DEMO_MODE=false

# Local only: lets `supabase start` enable phone auth so the test OTP numbers in
# supabase/config.toml work. Never a real Twilio token.
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=local-dev-not-a-real-token
